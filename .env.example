# Copie para .env.local e preencha com os dados do projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app (usada no link de confirmação de e-mail). Em produção: o domínio da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Leitura de documentos por IA (opcional). Sem credencial, o botão "Ler com IA" fica desativado.
# Os PDFs são enviados ao provedor de IA para leitura — avalie a base legal (LGPD) com o cliente.
# Opção 1: chave direta da Anthropic (tem preferência).
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=
# Opção 2: Vercel AI Gateway. Na Vercel, VERCEL_OIDC_TOKEN já existe sozinho (localmente, `vercel env pull`)
# e só é usado com AI_GATEWAY_ENABLED=1. Ou uma chave própria do Gateway.
# Os modelos da Anthropic exigem créditos pagos no Gateway (o plano grátis não dá acesso).
AI_GATEWAY_ENABLED=
AI_GATEWAY_API_KEY=
# Modelo no Gateway (padrão: anthropic/claude-opus-5.5)
AI_GATEWAY_MODEL=

# Certidões online (M5). Chave pedida em registrodeimoveis.org.br → "Solicitar chave de API".
REGISTRO_IMOVEIS_API_URL=
REGISTRO_IMOVEIS_API_KEY=
# 1 = liga o provedor simulado também em produção (só demonstração)
CERTIDOES_SIMULADO=
